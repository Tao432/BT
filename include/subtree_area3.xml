<root BTCPP_format="4">
    <BehaviorTree ID="SubTree_area3">
        <Sequence name="root_sequence">
            <Nevigation/>
            <Dicision/>
            <Switch2 variable="{have_kfs}" case_1="YES" case_2="NO">
                <Sequence name="put_kfs">
                    <Fallback>
                        <Sequence>
                            <Inverter>
                                <IsHighEnough/>
                            </Inverter>
                            <ClimbOnR1/>
                            <PutKfs/>
                        </Sequence>
                        
                        <PutKfs/>
                    </Fallback>
                </Sequence>

                <Sequence name="take_kfs">
                    <Nevigation/>  <!--test-->
                    <!-- <subtree ID="return_area2"/> -->
                </Sequence>
            </Switch2>
        </Sequence>
    </BehaviorTree>
</root>